<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <AssemblyName>AIMP.Launcher</AssemblyName>
    <RootNamespace>AIMP.Launcher</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AIMP.Protocol.Tests" />
    <PackageReference Include="CathodeLib" Version="0.12.2" />
    <ProjectReference Include="..\AIMP.Protocol\AIMP.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources\UI\*.GFX">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>UIBridge\%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>
  <Target Name="BuildInjector32" BeforeTargets="Build">
    <MSBuild
      Projects="..\AIMP.Injector32\AIMP.Injector32.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration);Platform=x86" />
  </Target>
  <Target Name="CopyInjector32" AfterTargets="Build">
    <ItemGroup>
      <InjectorFiles Include="..\AIMP.Injector32\bin\x86\$(Configuration)\net8.0\AIMP.Injector32.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(InjectorFiles)"
      DestinationFolder="$(OutDir)Injector32"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
